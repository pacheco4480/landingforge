  ASSISTED  @map("assisted")

  @@map("prospect_source_type")
}

enum ProspectSuppressionType {
  EMAIL   @map("email")
  DOMAIN  @map("domain")

  @@map("prospect_suppression_type")
}

enum ProjectStatus {
  BRIEFING           @map("briefing")
  CONTENT_COLLECTION @map("content_collection")
  PLANNING           @map("planning")
  DEVELOPMENT        @map("development")
  REVIEW             @map("review")
  APPROVED           @map("approved")
  DELIVERED          @map("delivered")
  MAINTENANCE        @map("maintenance")
  ARCHIVED           @map("archived")

  @@map("project_status")
}

enum PrivacyRequestType {
