  DESIGN
  SEO
  RELEASE

  @@map("project_approval_type")
}

enum ProjectApprovalDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED

  @@map("project_approval_decision")
}

enum ProjectMeetingType {
  CALL
  VIDEO_CALL
  IN_PERSON
  EMAIL
  OTHER

  @@map("project_meeting_type")
}

enum ProjectProposalStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED

