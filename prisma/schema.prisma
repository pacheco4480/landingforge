}

enum ProjectServiceType {
  TEMPLATE_ADAPTATION @map("template_adaptation")
  STRUCTURAL_CHANGE   @map("structural_change")
  NEW_TEMPLATE        @map("new_template")
  MAINTENANCE         @map("maintenance")

  @@map("project_service_type")
}

enum ProjectDeliveryMode {
  LANDING_ONLY     @map("landing_only")
  LANDING_WITH_CMS @map("landing_with_cms")

  @@map("project_delivery_mode")
}

enum ClientPackageExportStatus {
  READY   @map("ready")
  BLOCKED @map("blocked")
  FAILED  @map("failed")

  @@map("client_package_export_status")
}

enum ProjectMaintenanceReleaseStatus {
  DRAFT
  VALIDATED
