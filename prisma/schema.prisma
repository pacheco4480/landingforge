}

enum ProjectMaintenanceDestination {
  LANDINGFORGE_HOSTED
  CLIENT_HOSTED

  @@map("project_maintenance_destination")
}

enum ProjectParty {
  LANDINGFORGE   @map("landingforge")
  CLIENT         @map("client")
  SHARED         @map("shared")
  NOT_APPLICABLE @map("not_applicable")

  @@map("project_party")
}

enum MaintenancePlan {
  NONE       @map("none")
  ON_DEMAND  @map("on_demand")
  CONTRACTED @map("contracted")

  @@map("maintenance_plan")
}

enum ProjectBriefingStatus {
  DRAFT
  IN_PROGRESS
  REVIEW_REQUESTED
  APPROVED
  ARCHIVED

  @@map("project_briefing_status")
