model User {
  id                           String                      @id @default(uuid()) @db.Uuid
  name                         String
  email                        String                      @unique
  passwordHash                 String?                     @map("password_hash")
  avatarUrl                    String?                     @map("avatar_url")
  status                       UserStatus                  @default(INVITED)
  lastLoginAt                  DateTime?                   @map("last_login_at")
  passwordChangedAt            DateTime?                   @map("password_changed_at")
  authorizationVersion         Int                         @default(1) @map("authorization_version")
  createdAt                    DateTime                    @default(now()) @map("created_at")
  updatedAt                    DateTime                    @updatedAt @map("updated_at")
  deletedAt                    DateTime?                   @map("deleted_at")
  roles                        UserRole[]
  assignedLeads                Lead[]                      @relation("AssignedLeads")
  leadNotes                    LeadNote[]
  mediaAssets                  MediaAsset[]                @relation("MediaCreatedBy")
  notifications                Notification[]
  auditLogs                    AuditLog[]
  systemErrorLogs              SystemErrorLog[]
  createdBackups               Backup[]                    @relation("BackupCreatedBy")
  passwordResetTokens          PasswordResetToken[]
  updatedLegalSettings         LegalSetting[]              @relation("LegalSettingUpdatedBy")
  createdLegalDocumentVersions LegalDocumentVersion[]      @relation("LegalDocumentCreatedBy")
  projectAssignments           ProjectAssignment[]         @relation("ProjectAssignee")
  projectAssignmentsCreated    ProjectAssignment[]         @relation("ProjectAssignmentCreator")
  createdProjectSourceVersions ProjectSourceVersion[]      @relation("ProjectSourceVersionCreator")
  createdClientPackageExports  ClientPackageExport[]       @relation("ClientPackageExportCreator")
  createdMaintenanceReleases   ProjectMaintenanceRelease[] @relation("MaintenanceReleaseCreator")
  approvedMaintenanceReleases  ProjectMaintenanceRelease[] @relation("MaintenanceReleaseApprover")
  publishedMaintenanceReleases ProjectMaintenanceRelease[] @relation("MaintenanceReleasePublisher")
  createdBriefingRevisions     ProjectBriefingRevision[]   @relation("BriefingRevisionAuthor")
  createdBriefingShares        ProjectBriefingShare[]      @relation("BriefingShareCreator")
  decidedProjectApprovals      ProjectApproval[]           @relation("ProjectApprovalActor")
  createdProjectMeetings       ProjectMeeting[]            @relation("ProjectMeetingAuthor")
  createdProjectProposals      ProjectProposal[]           @relation("ProjectProposalAuthor")
  createdProjectAssets         ProjectAsset[]              @relation("ProjectAssetCreator")
  confirmedProjectAssetRights  ProjectAsset[]              @relation("ProjectAssetRightsConfirmer")
  createdAiContextExports      ProjectAiContextExport[]    @relation("ProjectAiContextAuthor")
  updatedProjectChecklistItems ProjectChecklistItem[]      @relation("ProjectChecklistUpdater")
  createdClientKnowledge       ClientKnowledgeEntry[]      @relation("ClientKnowledgeCreator")
  updatedClientKnowledge       ClientKnowledgeEntry[]      @relation("ClientKnowledgeUpdater")
  updatedPrivacyPolicies      PrivacyRetentionPolicy[]
  createdPrivacyRequests      PrivacyRequest[]            @relation("PrivacyRequestCreator")
  verifiedPrivacyRequests     PrivacyRequest[]            @relation("PrivacyRequestVerifier")
  createdProspects             Prospect[]                  @relation("ProspectCreator")
  assignedProspects            Prospect[]                  @relation("ProspectAssignee")
  createdProspectSuppressions  ProspectSuppression[]       @relation("ProspectSuppressionCreator")
  createdProspectTemplates     ProspectEmailTemplate[]     @relation("ProspectTemplateCreator")
  authoredProspectOutreach     ProspectOutreachDraft[]     @relation("ProspectOutreachAuthor")

  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model SiteSetting {
  id              String        @id @default(uuid()) @db.Uuid
  siteName        String        @map("site_name")
  businessName    String        @map("business_name")
  businessType    String        @map("business_type")
  domain          String?       @unique
  defaultLanguage String        @default("pt-PT") @map("default_language")
  timezone        String        @default("Europe/Lisbon")
  contactEmail    String        @map("contact_email")
  contactPhone    String?       @map("contact_phone")
  address         String?
  city            String?
  region          String?
  country         String?
  postalCode      String?       @map("postal_code")
  latitude        Float?
  longitude       Float?
  openingHours    String?       @map("opening_hours")
  whatsappUrl     String?       @map("whatsapp_url")
  facebookUrl     String?       @map("facebook_url")
  instagramUrl    String?       @map("instagram_url")
  linkedinUrl     String?       @map("linkedin_url")
  primaryColor    String        @map("primary_color")
  secondaryColor  String        @map("secondary_color")
  accentColor     String        @map("accent_color")
  logoMediaId     String?       @map("logo_media_id") @db.Uuid
  faviconMediaId  String?       @map("favicon_media_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  logoMedia       MediaAsset?   @relation("SiteLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMedia    MediaAsset?   @relation("SiteFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  legalSettings   LegalSetting?

  @@map("site_settings")
}

model ClientSetting {
  id                    String                @id @default(uuid()) @db.Uuid
  language              String                @default("pt-PT")
  timezone              String                @default("Europe/Lisbon")
  currency              String                @default("EUR")
  dateFormat            String                @default("dd/MM/yyyy") @map("date_format")
  analyticsEnabled      Boolean               @default(false) @map("analytics_enabled")
  maintenanceMode       Boolean               @default(false) @map("maintenance_mode")
  maintenanceMessage    String?               @map("maintenance_message")
  emailDigestFrequency  EmailDigestFrequency  @default(DISABLED) @map("email_digest_frequency")
  emailDigestHour       Int                   @default(9) @map("email_digest_hour")
  emailDigestRecipient  String?               @map("email_digest_recipient")
  emailDigestWeekday    Int                   @default(1) @map("email_digest_weekday")
  emailDigestLastSentAt DateTime?             @map("email_digest_last_sent_at")
  emailDigestLastStatus EmailDeliveryStatus?  @map("email_digest_last_status")
  deploymentMode        DeploymentMode        @default(CLIENT) @map("deployment_mode")
  deploymentEnvironment DeploymentEnvironment @default(LOCAL) @map("deployment_environment")
  deploymentStatus      DeploymentStatus      @default(NOT_STARTED) @map("deployment_status")
  domainStatus          DomainStatus          @default(NOT_CONFIGURED) @map("domain_status")
  sslStatus             SslStatus             @default(NOT_CONFIGURED) @map("ssl_status")
  readyForDelivery      Boolean               @default(false) @map("ready_for_delivery")
  deliveryChecklist     Json?                 @map("delivery_checklist")
  lastDeploymentCheckAt DateTime?             @map("last_deployment_check_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@index([emailDigestFrequency])
  @@index([deploymentStatus])
  @@map("client_settings")
}

model SecuritySetting {
  id                        String   @id @default(uuid()) @db.Uuid
  turnstileEnabled          Boolean  @default(false) @map("turnstile_enabled")
  turnstileSiteKey          String?  @map("turnstile_site_key")
  honeypotEnabled           Boolean  @default(true) @map("honeypot_enabled")
  duplicateCooldownSeconds  Int      @default(60) @map("duplicate_cooldown_seconds")
  loginLimitPerMinute       Int      @default(5) @map("login_limit_per_minute")
  passwordResetLimitPerHour Int      @default(3) @map("password_reset_limit_per_hour")
  formLimitPerMinute        Int      @default(5) @map("form_limit_per_minute")
  uploadLimitPerMinute      Int      @default(10) @map("upload_limit_per_minute")
  apiLimitPerMinute         Int      @default(60) @map("api_limit_per_minute")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("security_settings")
}

model Industry {
  id          String     @id @default(uuid()) @db.Uuid
  key         String     @unique
  name        String
  description String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  templates   Template[]
  projects    Project[]

  @@index([isActive])
  @@map("industries")
}

model Template {
  id          String            @id @default(uuid()) @db.Uuid
  industryId  String            @map("industry_id") @db.Uuid
  key         String            @unique
  name        String
  description String?
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  industry    Industry          @relation(fields: [industryId], references: [id], onDelete: Restrict)
  variants    TemplateVariant[]
  pages       Page[]
  projects    Project[]

  @@index([industryId])
  @@index([isActive])
  @@map("templates")
}

model TemplateVariant {
  id          String    @id @default(uuid()) @db.Uuid
  templateId  String    @map("template_id") @db.Uuid
  key         String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  template    Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pages       Page[]
  projects    Project[]

  @@unique([templateId, key])
  @@index([isActive])
  @@map("template_variants")
}

model Theme {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  key                String   @unique
  primaryColor       String   @map("primary_color")
  secondaryColor     String   @map("secondary_color")
  accentColor        String   @map("accent_color")
  backgroundColor    String   @map("background_color")
  surfaceColor       String   @map("surface_color")
  textPrimaryColor   String   @map("text_primary_color")
  textSecondaryColor String   @map("text_secondary_color")
  headingFont        String   @map("heading_font")
  bodyFont           String   @map("body_font")
  borderRadius       String   @map("border_radius")
  shadowStyle        String   @map("shadow_style")
  settings           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  pages              Page[]

  @@map("themes")
}

model Page {
  id                    String                     @id @default(uuid()) @db.Uuid
  templateId            String?                    @map("template_id") @db.Uuid
  templateVariantId     String?                    @map("template_variant_id") @db.Uuid
  themeId               String?                    @map("theme_id") @db.Uuid
  title                 String
  slug                  String                     @unique
  status                PageStatus                 @default(DRAFT)
  pageType              PageType                   @default(LANDING) @map("page_type")
  isDemo                Boolean                    @default(false) @map("is_demo")
  demoKey               String?                    @unique @map("demo_key")
  demoStatus            DemoStatus?                @map("demo_status")
  portfolioVisible      Boolean                    @default(false) @map("portfolio_visible")
  portfolioOrder        Int?                       @map("portfolio_order")
  publishedAt           DateTime?                  @map("published_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  deletedAt             DateTime?                  @map("deleted_at")
  template              Template?                  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVariant       TemplateVariant?           @relation(fields: [templateVariantId], references: [id], onDelete: SetNull)
  theme                 Theme?                     @relation(fields: [themeId], references: [id], onDelete: SetNull)
  sections              PageSection[]
  forms                 Form[]
  thankYouForForms      Form[]                     @relation("FormThankYouPage")
  submissions           FormSubmission[]
  seoSetting            SeoSetting?
  analyticsEvents       AnalyticsEvent[]
  privacyLegalSettings  LegalSetting[]             @relation("PrivacyLegalPage")
  cookieLegalSettings   LegalSetting[]             @relation("CookieLegalPage")
  termsLegalSettings    LegalSetting[]             @relation("TermsLegalPage")
  legalDocumentVersions LegalDocumentVersion[]
  portfolioScreenshots  PortfolioScreenshot[]
  sourceVersions        ProjectSourceVersion[]     @relation("ProjectSourcePage")
  provisionedVersions   ProjectSourceVersion[]     @relation("ProjectProvisionedPage")
  maintenanceCandidate  ProjectMaintenanceRelease? @relation("MaintenanceCandidatePage")

  @@index([templateId])
  @@index([templateVariantId])
  @@index([themeId])
  @@index([status])
  @@index([pageType])
  @@index([isDemo])
  @@index([isDemo, demoStatus])
  @@index([portfolioVisible, portfolioOrder])
  @@map("pages")
}

model PageSection {
  id          String    @id @default(uuid()) @db.Uuid
  pageId      String    @map("page_id") @db.Uuid
  sectionKey  String    @map("section_key")
  sectionType String    @map("section_type")
  name        String
  sortOrder   Int       @default(0) @map("sort_order")
