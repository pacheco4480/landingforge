# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_NAME=LandingForge

# Feature modes
CMS_ENABLED=false
INTERNAL_DEMO_MODE=false

# PostgreSQL
# Use a pooled connection for application runtime when using Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/landingforge

# Use a direct connection for Prisma migrations when using Supabase.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/landingforge

# Authentication
AUTH_SECRET=replace-with-a-secure-random-secret
AUTH_URL=http://localhost:3000

# Cron jobs
CRON_SECRET=replace-with-a-secure-random-secret

# Email
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=landingforge-media
MEDIA_MAX_UPLOAD_MB=10
# Optional private bucket for Super Admin-only portfolio screenshots of the CMS.
SUPABASE_PORTFOLIO_PRIVATE_BUCKET=

# Error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Anti-spam
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional local-only development users
SEED_SUPER_ADMIN_PASSWORD=
SEED_CLIENT_ADMIN_PASSWORD=
SEED_VIEWER_PASSWORD=
